From 0e94a065d7f22af719581b4a2bd75c36465e96ed Mon Sep 17 00:00:00 2001
From: beingsk5 <takeiteasy4possible@gmail.com>
Date: Sun, 23 Nov 2025 19:29:23 +0530
Subject: [PATCH] Update cmdline.c

---
 fs/proc/cmdline.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/fs/proc/cmdline.c b/fs/proc/cmdline.c
index 403cbb12a6e9b..7c3fad2cb84c6 100644
--- a/fs/proc/cmdline.c
+++ b/fs/proc/cmdline.c
@@ -4,8 +4,18 @@
 #include <linux/proc_fs.h>
 #include <linux/seq_file.h>
 
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+extern int susfs_spoof_cmdline_or_bootconfig(struct seq_file *m);
+#endif
+
 static int cmdline_proc_show(struct seq_file *m, void *v)
 {
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	if (!susfs_spoof_cmdline_or_bootconfig(m)) {
+		seq_putc(m, '\n');
+		return 0;
+	}
+#endif
 	seq_printf(m, "%s\n", saved_command_line);
 	return 0;
 }
